# ============================================================
# XMD_SAAS - Docker Environment Variables
# Copy file này thành .env và điền giá trị thật
# ============================================================

# Database password (tạo bằng: openssl rand -hex 16)
DB_PASS=changeme_strong_password

# JWT secret (tạo bằng: openssl rand -hex 32)
JWT_SECRET=change_this_to_random_64_chars

# Domain frontend (dùng cho CORS)
FRONTEND_URL=https://erp.ten-mien.vn
