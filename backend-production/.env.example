NODE_ENV=development
PORT=5000

# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT (Supabase tự quản lý JWT, dùng key này để verify nếu cần)
JWT_SECRET=your-supabase-jwt-secret

# Frontend — một hoặc nhiều origin (phẩy), bắt buộc khớp Origin trình duyệt (vd GitHub Pages: https://thanktriet.github.io)
FRONTEND_URL=http://localhost:3000,https://thanktriet.github.io

# ─── SEPay Webhook ───────────────────────────────────────────────────────────
# Lấy từ Dashboard SEPay → WebHooks → chọn webhook → API Key
# Dùng để xác thực request POST từ SEPay (header: Authorization: Apikey <key>)
SEPAY_API_KEY=your_sepay_api_key

# ─── MISA AMIS Integration ────────────────────────────────────────────────────
# AMIS_MOCK=true  → dung MockAmisClient (khong can credentials that)
# AMIS_MOCK=false → dung real AMIS API (can dien client_id + client_secret)
AMIS_MOCK=true

# Credentials that — lay tu MISA Developer Portal sau khi dang ky
AMIS_CLIENT_ID=your_amis_client_id
AMIS_CLIENT_SECRET=your_amis_client_secret
AMIS_COMPANY_ID=your_amis_company_id

# API base URL (default: AMIS production)
AMIS_BASE_URL=https://actapp.misa.vn/api/v3

# Ky hieu hoa don + mau hoa don (lay tu AMIS sau khi dang ky phat hanh)
AMIS_INVOICE_SERIES=C23TTGT
AMIS_INVOICE_TEMPLATE=01GTKT0/001

# Worker poll interval (ms). Default: 30000 (30s)
AMIS_WORKER_INTERVAL_MS=30000
