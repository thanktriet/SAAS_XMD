NODE_ENV=production
PORT=5000

# Supabase production
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJxxx...
SUPABASE_SERVICE_ROLE_KEY=eyJxxx...
JWT_SECRET=<JWT secret từ Supabase project Settings → API>

# Domain frontend
FRONTEND_URL=https://xmd.vinfastnamthang.vn

# SEPay
SEPAY_API_KEY=<api key từ SEPay dashboard>

# MISA AMIS — dùng mock khi chưa đăng ký
AMIS_MOCK=true
AMIS_CLIENT_ID=
AMIS_CLIENT_SECRET=
AMIS_COMPANY_ID=
AMIS_BASE_URL=https://actapp.misa.vn/api/v3
AMIS_INVOICE_SERIES=C23TTGT
AMIS_INVOICE_TEMPLATE=01GTKT0/001
AMIS_WORKER_INTERVAL_MS=30000
